# Copier ce fichier en .env et remplir les valeurs (ou définir les variables d'environnement à la main).
# L'app ne charge pas .env automatiquement ; en local tu peux faire : Get-Content .env | ForEach { $var = $_ -split '='; [Environment]::SetEnvironmentVariable($var[0], $var[1], 'Process') }

# Base de données (optionnel, par défaut SQLite)
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname

# Session (recommandé en production)
# SECRET_KEY=une-cle-secrete-longue-et-aleatoire

# Envoi d'emails (confirmation demande d'accès)
# Gmail :
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=ton.email@gmail.com
# MAIL_PASSWORD=mot_de_passe_application_16_caracteres
# MAIL_FROM=ton.email@gmail.com

# SendGrid :
# MAIL_SERVER=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=ta_cle_api_sendgrid
# MAIL_FROM=adresse_verifiee@mondomaine.com

# Brevo :
